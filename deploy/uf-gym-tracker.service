[Unit]
Description=UF Gym Crowd Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tracker
WorkingDirectory=/opt/uf-gym-tracker/backend

Environment="POLL_INTERVAL_SECONDS=60"
Environment="ENABLE_FRAME_ENDPOINT=false"
Environment="CORS_ORIGINS="
Environment="OPEN_HOUR=6"
Environment="CLOSE_HOUR=24"

ExecStart=/opt/uf-gym-tracker/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000

# Restart on crash — a transient failure shouldn't end the poll loop for good.
Restart=always
RestartSec=10

# Basic hardening: the service can only write to its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uf-gym-tracker/backend/data

[Install]
WantedBy=multi-user.target
